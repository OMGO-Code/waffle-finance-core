# ──────────────────────────────────────────────────────────────────────────────
# WaffleFinance Frontend — environment variable reference
#
# Copy this file to .env and fill in every value before starting the service.
# Lines beginning with # are comments.  Do NOT commit a populated .env file.
# ──────────────────────────────────────────────────────────────────────────────

# ── Network ───────────────────────────────────────────────────────────────────
# Target network: "testnet" or "mainnet"
VITE_NETWORK=testnet

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Explicit toggles for experimental functionality. Defaults are safe (false).

# Force Solana into simulation/mock mode even when a real program ID is configured.
# VITE_FEATURE_SOLANA_SIMULATION_MODE=false

# Enable early Soroban chain support (experimental routes and contract bindings).
# VITE_FEATURE_SOROBAN_EARLY_SUPPORT=false

# Enable experimental UI routes and features not yet ready for production users.
# VITE_FEATURE_EXPERIMENTAL_UI_ROUTES=false

# ── Mainnet gating ────────────────────────────────────────────────────────────
# Set to true to enable mainnet mode (post-audit / mainnet launch)
# VITE_MAINNET_ENABLED=false

# ── RPC URLs ──────────────────────────────────────────────────────────────────
# Optional explicit RPC URLs (fallbacks are provided by the config package)
# VITE_SEPOLIA_RPC_URL=
# VITE_MAINNET_RPC_URL=

# ── API Keys ──────────────────────────────────────────────────────────────────
# Optional Infura project ID (used to build RPC URLs when explicit URLs are unset)
# VITE_INFURA_API_KEY=
# Optional 1inch API key
# VITE_ONEINCH_API_KEY=

# ── Backend ───────────────────────────────────────────────────────────────────
# Base URL for the coordinator/relayer API
# VITE_API_BASE_URL=http://localhost:3001
